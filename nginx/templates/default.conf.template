# Прод-конфиг. Домен подставляется из переменной APP_DOMAIN при старте
# контейнера (см. nginx/Dockerfile): образ один, а стендов может быть несколько.
#
# Подставляются только переменные с префиксом APP_ — фильтр задан в Dockerfile.
# Иначе envsubst съел бы и $http_host, и $uri, и всё остальное, что nginx
# считает своими переменными.

upstream backend    { server backend:8000; }
upstream hocuspocus { server hocuspocus:1234; }
upstream frontend   { server frontend:80; }

# ── HTTP: только проверка Let's Encrypt и переезд на HTTPS ───────────────────
server {
    listen 80;
    server_name ${APP_DOMAIN} www.${APP_DOMAIN};

    # ACME-проверка должна отвечать по http и до всякого редиректа: certbot
    # ходит именно сюда, и увести его на https значит не получить сертификат
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://${APP_DOMAIN}$request_uri;
    }
}

# ── www → основной домен ─────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name www.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    return 301 https://${APP_DOMAIN}$request_uri;
}

# ── Само приложение ──────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    include /etc/nginx/ssl-params.conf;

    client_max_body_size 50M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain text/css text/javascript text/xml
        application/json application/javascript application/xml
        image/svg+xml;

    # Заголовки безопасности вынесены в файл и подключаются заново в каждом
    # location со своим add_header: nginx наследует add_header с уровня
    # server, только если в location нет ни одного своего. Из-за этого
    # /static/ и /media/ раньше уходили без nosniff и HSTS.
    include /etc/nginx/security-headers.conf;

    # ── Статика Django ────────────────────────────────────────────────────────
    location /static/ {
        alias /app/staticfiles/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
        access_log off;
    }

    # ── Загруженные файлы ─────────────────────────────────────────────────────
    # Напрямую не отдаются: ссылку подписывает Django и отвечает
    # X-Accel-Redirect сюда (см. backend/apps/common/media.py). Снаружи этот
    # location недоступен — internal.
    location /protected-media/ {
        internal;
        alias /app/media/;
        # Тип и Content-Disposition выставил Django по белому списку, nginx
        # берёт их из его ответа. Своего угадывания по расширению тут быть не
        # должно: для .html оно дало бы text/html.
        types { }
        default_type application/octet-stream;
        include /etc/nginx/security-headers.conf;
    }

    # Старые адреса вида /media/... больше ничего не отдают — иначе они
    # проваливались бы в SPA и возвращали index.html со статусом 200
    location /media/ {
        return 404;
    }

    # Служебные эндпоинты доски — только для Hocuspocus. Он ходит в backend
    # напрямую по сети docker, снаружи им делать нечего. Именно ^~: без него
    # regex-location ниже (^/(api|admin)/) перебивает префикс, и запрос
    # уходит в Django как ни в чём не бывало.
    location ^~ /api/whiteboard/ {
        return 404;
    }

    # ── Django REST API + Admin ───────────────────────────────────────────────
    location ~ ^/(api|admin)/ {
        proxy_pass         http://backend;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_redirect     off;
    }

    # ── Hocuspocus WebSocket (Excalidraw / Yjs) ───────────────────────────────
    # HocuspocusProvider обрезает завершающий слэш, поэтому ловим и /board, и /board/.
    # Имя документа (room_id) передаётся протоколом Hocuspocus, а не путём URL.
    location ^~ /board {
        proxy_pass         http://hocuspocus/;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $http_host;
        proxy_set_header   X-Real-IP  $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_redirect     off;
    }

    # ── React SPA (catch-all) ─────────────────────────────────────────────────
    location / {
        proxy_pass       http://frontend;
        proxy_set_header Host      $http_host;
        proxy_set_header X-Real-IP $remote_addr;

        # Токены лежат в localStorage, так что любой внедрённый скрипт —
        # это чужой вход в аккаунт. CSP разрешает только свои скрипты, без
        # inline и eval. Стили inline нужны React и Excalidraw, шрифты
        # интерфейса — с Google Fonts, доска — WebSocket на свой же домен.
        # Только для SPA: PDF-просмотрщик Chrome под такой политикой не
        # открывается, а у админки Django свои inline-скрипты.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss://${APP_DOMAIN}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
        include /etc/nginx/security-headers.conf;
    }
}
