{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // Тесты и их конфиг из сборки исключены: иначе `npm run build` тащил бы их
  // в dist, а прод-образ — заодно и vitest с nock, которые после
  // `npm prune --omit=dev` уже удалены
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "vitest.config.ts"]
}
