# Конфиг раннера. Скопировать в config/config.toml и вписать токен.
#
# Регистрировать раннер командой `register` не нужно: в GitLab 16+ раннер
# заводится в интерфейсе проекта (Settings → CI/CD → Runners → New project
# runner), там же задаётся тег, а сюда переносится готовый токен `glrt-…`.

# Сколько джоб раннер берёт одновременно. Считать по памяти сборочной машины:
# сборка фронтенда съедает около двух гигабайт, остальные джобы заметно легче.
# На четырёх гигабайтах ставить 2, на восьми — 4. Матрица сборки всё равно из
# четырёх джоб, так что больше четырёх смысла не имеет.
concurrent = 2

# Как часто спрашивать GitLab о новых джобах, секунды
check_interval = 3

# Ждать завершения текущих джоб при остановке раннера, а не обрывать их
shutdown_timeout = 30

[session_server]
  session_timeout = 1800

[[runners]]
  name = "study-platform"
  url = "https://gitlab.com"
  # ← сюда токен из интерфейса проекта
  token = "glrt-PASTE_TOKEN_HERE"
  executor = "docker"

  [runners.docker]
    # Образ на случай, если джоба своего не указала. У нас указывают все.
    image = "alpine:3.20"

    # Привилегии не нужны: docker-in-docker мы не используем, вместо него
    # джобам отдаётся сокет хоста (см. volumes ниже)
    privileged = false

    volumes = [
      # Тот же размен, что и у самого раннера: джоба говорит с демоном хоста
      # напрямую. Благодаря этому слои остаются между сборками, и вторая
      # сборка того же образа занимает секунды вместо минут.
      "/var/run/docker.sock:/var/run/docker.sock",
      # Кеш GitLab (node_modules, .venv) между джобами
      "/cache",
    ]

    # Свежие образы тянуть, но не ходить в сеть, если он уже есть локально
    pull_policy = ["always", "if-not-present"]

    # Ограничение памяти на джобу. Раскомментировать, если сборка начнёт
    # вытеснять всё остальное на машине. Меньше 2g фронтенд не соберётся.
    # memory = "2g"
    # memory_swap = "4g"
    # cpus = "2"

    # Пустой шаблон, чтобы docker сам выбрал разумные значения
    shm_size = 0

  [runners.cache]
    # Кеш локальный, в томе `/cache`. Внешнее хранилище (S3) имеет смысл,
    # только когда раннеров несколько.
    Type = "local"
