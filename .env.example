# Django
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL
POSTGRES_DB=studyplatform
POSTGRES_USER=studyplatform
POSTGRES_PASSWORD=studyplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Hocuspocus ↔ Django shared secret (generate with: openssl rand -hex 32)
HOCUSPOCUS_SECRET=change-this-to-a-random-secret

# Hocuspocus
DJANGO_API_URL=http://backend:8000
HOCUSPOCUS_PORT=1234

# ── Только прод ──────────────────────────────────────────────────────────────
# Домен подставляется в конфиг nginx при старте контейнера — без схемы и без www
APP_DOMAIN=example.com

ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com
# Django 4+ сверяет Origin при небезопасных запросах: без этого вход
# в админку за прокси отвергается по CSRF
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# На первом запуске — False: сертификата ещё нет, и редирект отправил бы
# по кругу саму ACME-проверку. После выпуска вернуть True.
SECURE_SSL_REDIRECT=True

# Тег образов, который поднимает docker compose. Обычно его задаёт deploy.sh
# из CI; вручную имеет смысл только для отката на конкретный коммит.
# IMAGE_TAG=latest
