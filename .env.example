# Django
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL
POSTGRES_DB=studyplatform
POSTGRES_USER=studyplatform
POSTGRES_PASSWORD=studyplatform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Hocuspocus ↔ Django shared secret (generate with: openssl rand -hex 32)
HOCUSPOCUS_SECRET=change-this-to-a-random-secret

# Hocuspocus
DJANGO_API_URL=http://backend:8000
HOCUSPOCUS_PORT=1234

# Production only
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
